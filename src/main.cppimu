#include "naca_imu/naca_imu.h"

void setup()
{
    Serial.begin(115200);
    while (!Serial)
        ;
    Serial.println("IMU test");

    if (!naca_imu_init())
    {
        while (1)
            ;
    }
}

void loop()
{
    naca_imu_update(0, false, YAW_MODE_FLAT);
    IMUSnapshot snapshot = naca_imu_get_snapshot();
    Serial.printf("Yaw: %.2f, Gyro: (%.2f), Accel: (%.2f, %.2f, %.2f)\n",
                  snapshot.yaw, snapshot.gz,
                  snapshot.ax, snapshot.ay, snapshot.az);
    // Main loop code
}